<Window x:Class="ListLabel.Design.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" x:Name="Window">
    <DockPanel  DataContext="{Binding ElementName=Window, Path=ViewModel}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Edit" Command="{Binding Path=EditCommand}"></MenuItem>
                <MenuItem Header="Print" Command="{Binding Path=PrintCommand}"></MenuItem>
                <MenuItem Header="New" Command="{Binding Path=NewCommand}"></MenuItem>
                <MenuItem Header="UploadCommand" Command="{Binding Path=UploadCommand}"></MenuItem>
                <MenuItem Header="Reload" Command="{Binding Path=ReloadCommand}"></MenuItem>
                <MenuItem Header="Delete" Command="{Binding Path=DeleteCommand}"></MenuItem>
                <MenuItem Header="Assign Type">
                    <MenuItem Header="Label 1" Command="{Binding Path=AssignOne}"></MenuItem>
                    <MenuItem Header="Label 2" Command="{Binding Path=AssignTwo}"></MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Exit" Command="Close"></MenuItem>
            </MenuItem>
        </Menu>
        <Grid>
            <DataGrid ItemsSource="{Binding Path=LabelList}"
                      GridLinesVisibility="None" 
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectedItem="{Binding Path=SelectedArticleLabel}"
            >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Path=RepositoryId}"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Path=Name}"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Path=Type}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>        
    </DockPanel>
</Window>

